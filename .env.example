# App domain (used in metadata, links)
# NEXT_PUBLIC_APP_URL=https://ribil.co

# PDF backend. Run with: npm run api
PDF_BACKEND_URL=http://localhost:3001

# Optional: proxy for requests to landrecords.karnataka.gov.in
# PROXY_URL=

# Optional: point frontend directly to backend. Leave unset to use Next.js proxy.
# NEXT_PUBLIC_API_URL=https://ribil.co

# Production (ribil.co):
# PDF_BACKEND_URL=https://ribil.co
# NEXT_PUBLIC_APP_URL=https://ribil.co
