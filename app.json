{
  "expo": {
    "name": "Ribil",
    "slug": "ribil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ribil.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "co.ribil.app"
    },
    "web": {
    },
    "scheme": "ribil",
    "extra": {
      "apiUrl": "https://ribil.co"
    }
  }
}
