{
  "name": "ribil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api": "PORT=3001 node api/server.js",
    "cap:add:android": "cap add android",
    "cap:copy": "npm run build && cap copy android",
    "cap:sync": "npm run build && cap sync android",
    "android": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "play:publish": "node publish-android-to-play.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.5",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^7.6.5",
    "https-proxy-agent": "^7.0.2",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "express": "^4.22.1",
    "postcss": "^8.4.0",
    "puppeteer": "^24.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
