#!/usr/bin/env bash
#
# ribil-serve — turn this machine into the ribil.co land-records API backend.
#
# The frontend lives on Railway; this machine only runs the scraping API
# (village map + RTC) because the Karnataka gov site requires an Indian IP.
# It starts the API server and opens a Cloudflare tunnel so the API is reachable
# at https://api.ribil.co. Ctrl+C stops both.
#
# Usage:
#   ./ribil-serve                  # serve the API
#   ./ribil-serve --with-frontend  # also build & serve the static site locally
#
# Config (override via env):
#   RIBIL_HOSTNAME       public API hostname        (default: api.ribil.co)
#   RIBIL_PORT           local API port             (default: 3001)
#   RIBIL_TUNNEL_TOKEN   Cloudflare tunnel token    (portable: no files needed)
#   RIBIL_TUNNEL         named tunnel (creds-file mode, default: ribil-mac)
#
set -euo pipefail

HOSTNAME_FQDN="${RIBIL_HOSTNAME:-api.ribil.co}"
# All hostnames this tunnel should serve from :PORT (space-separated). The API
# host plus www (which the server 301-redirects to the apex).
HOSTS="${RIBIL_HOSTS:-${HOSTNAME_FQDN} www.ribil.co}"
PORT="${RIBIL_PORT:-3001}"
TUNNEL_NAME="${RIBIL_TUNNEL:-ribil-mac}"
API_BASE="https://${HOSTNAME_FQDN}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

c_y=$'\033[1;33m'; c_g=$'\033[1;32m'; c_r=$'\033[1;31m'; c_x=$'\033[0m'
log(){ printf "%s[ribil]%s %s\n" "$c_y" "$c_x" "$*"; }
ok(){  printf "%s[ribil]%s %s\n" "$c_g" "$c_x" "$*"; }
die(){ printf "%s[ribil] %s%s\n" "$c_r" "$*" "$c_x" >&2; exit 1; }

# ---- prerequisites ----
command -v node        >/dev/null || die "node not found. Install Node 18+ first."
command -v cloudflared >/dev/null || die "cloudflared not found. Install it: macOS 'brew install cloudflared' · Debian/Ubuntu 'sudo apt install cloudflared' · or https://pkg.cloudflare.com"
[ -f api/server.js ] || die "Run this from the Ribil project (api/server.js missing)."

# ---- parse flag ----
WITH_FRONTEND="no"
case "${1:-}" in
  --with-frontend) WITH_FRONTEND="yes" ;;
  "") ;;
  *) die "Unknown option: $1 (use --with-frontend to also serve the static site)" ;;
esac

# ---- deps ----
[ -d node_modules ] || { log "Installing npm dependencies (first run)…"; npm install; }

# ---- optionally build the static site (normally the frontend is on Railway) ----
if [ "$WITH_FRONTEND" = "yes" ]; then
  log "Building static site → ${API_BASE} …"
  rm -rf out .next
  NEXT_PUBLIC_PI_URL="$API_BASE" NEXT_PUBLIC_CF_PROXY_URL="$API_BASE" npm run build >/dev/null
  ok "Build complete (this machine will also serve the frontend)."
else
  log "API-only mode (frontend is hosted on Railway). Use --with-frontend to serve it here too."
fi

# ---- stop anything already on the port / prior tunnels (avoid duplicates) ----
EXIST="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
[ -n "$EXIST" ] && { log "Freeing port ${PORT}…"; kill $EXIST 2>/dev/null || true; sleep 1; }
if pgrep -f "cloudflared tunnel" >/dev/null 2>&1; then
  log "Stopping existing cloudflared tunnel (prevents same-tunnel collisions)…"
  pkill -f "cloudflared tunnel" 2>/dev/null || true; sleep 2
fi

API_PID=""; TUNNEL_PID=""
cleanup(){
  printf "\n"; log "Shutting down…"
  [ -n "$TUNNEL_PID" ] && kill "$TUNNEL_PID" 2>/dev/null || true
  [ -n "$API_PID" ]    && kill "$API_PID"    2>/dev/null || true
  ok "Stopped. ${HOSTNAME_FQDN} is no longer served from this machine."
}
trap cleanup EXIT INT TERM

# ---- start API server ----
log "Starting API server on :${PORT} …"
PDF_BACKEND_URL= PORT="$PORT" node api/server.js >/tmp/ribil-api.log 2>&1 &
API_PID=$!
for i in $(seq 1 30); do
  curl -sf "http://localhost:${PORT}/api/ping" >/dev/null 2>&1 && break
  kill -0 "$API_PID" 2>/dev/null || die "API server crashed. See /tmp/ribil-api.log"
  sleep 0.5
done
ok "API server up (village map + RTC)."

# ---- start the tunnel ----
if [ -n "${RIBIL_TUNNEL_TOKEN:-}" ]; then
  # Fully portable: token carries everything, no local files needed.
  # (Requires the Public Hostname ${HOSTNAME_FQDN} → http://localhost:${PORT}
  #  to be configured on the tunnel in the Cloudflare dashboard.)
  log "Starting tunnel via token …"
  cloudflared tunnel run --token "$RIBIL_TUNNEL_TOKEN" >/tmp/ribil-tunnel.log 2>&1 &
  TUNNEL_PID=$!
else
  # Creds-file mode. Accept creds 3 ways (first wins):
  #   1. RIBIL_TUNNEL_CREDS_B64  — base64 of the tunnel json (great for bootstrap)
  #   2. existing ~/.cloudflared/*.json
  mkdir -p "$HOME/.cloudflared"
  if [ -n "${RIBIL_TUNNEL_CREDS_B64:-}" ] && ! ls "$HOME"/.cloudflared/*.json >/dev/null 2>&1; then
    log "Writing tunnel credentials from RIBIL_TUNNEL_CREDS_B64…"
    printf '%s' "$RIBIL_TUNNEL_CREDS_B64" | base64 -d > "$HOME/.cloudflared/ribil-tunnel.json" 2>/dev/null \
      || die "RIBIL_TUNNEL_CREDS_B64 is not valid base64."
  fi
  CRED="$(ls "$HOME"/.cloudflared/*.json 2>/dev/null | head -1 || true)"
  [ -n "$CRED" ] || die "No tunnel credentials found. Provide one of:
   • export RIBIL_TUNNEL_CREDS_B64=<base64 of the tunnel .json>, or
   • export RIBIL_TUNNEL_TOKEN=<token>, or
   • copy your tunnel .json into ~/.cloudflared/"
  # Tunnel ID comes from inside the json (filename-independent).
  TUNNEL_ID="$(grep -oE '"TunnelID"[: ]*"[0-9a-fA-F-]{36}"' "$CRED" | grep -oE '[0-9a-fA-F-]{36}' | head -1)"
  [ -n "$TUNNEL_ID" ] || TUNNEL_ID="$(basename "$CRED" .json)"
  CFG="$(mktemp -t ribil-cf).yml"
  {
    echo "tunnel: ${TUNNEL_ID}"
    echo "credentials-file: ${CRED}"
    echo "ingress:"
    for h in $HOSTS; do
      echo "  - hostname: ${h}"
      echo "    service: http://localhost:${PORT}"
    done
    echo "  - service: http_status:404"
  } > "$CFG"
  log "Starting tunnel ${TUNNEL_ID} → [${HOSTS}] …"
  cloudflared tunnel --config "$CFG" run >/tmp/ribil-tunnel.log 2>&1 &
  TUNNEL_PID=$!
fi

# ---- wait for the tunnel to register, then verify end-to-end ----
for i in $(seq 1 40); do
  grep -q "Registered tunnel connection" /tmp/ribil-tunnel.log 2>/dev/null && break
  kill -0 "$TUNNEL_PID" 2>/dev/null || die "Tunnel failed to start. See /tmp/ribil-tunnel.log"
  sleep 0.5
done
sleep 2
if curl -sf -m 20 "${API_BASE}/api/ping" >/dev/null 2>&1; then
  ok "Live → ${API_BASE} is now served from this machine."
else
  log "Tunnel up, but ${API_BASE} didn't answer yet (DNS may still be propagating, or the apex isn't routed to this tunnel)."
fi

echo
ok "Serving. Logs: /tmp/ribil-api.log  /tmp/ribil-tunnel.log"
log "Press Ctrl+C to stop."

# ---- latest-wins lease: yield automatically if a newer machine takes over ----
# Runs in the foreground; exits (code 7) when superseded -> cleanup stops this
# machine's API + tunnel. Blocks forever if a server crashes here.
if [ -f scripts/server-lease.cjs ]; then
  node scripts/server-lease.cjs || true
  log "Active-server lease released."
else
  wait
fi
